# Copy to `.env` in the repo root and commit it: non-secret defaults read by
# com.company.env.
# Precedence (later wins): process env -> .env -> .env.local -> explicit overrides.
#
# Secrets MUST go in .env.local (gitignored) or the real environment.
# Config reads secrets with #env/local, which throws if the var is defined in .env.

WEBSITE_SERVICE_PORT=3001
PORTAL_SERVICE_PORT=3002
PORTAL_BASE_URL=http://localhost:3002

DATABASE_URL=postgresql://localhost:5432/app_dev
REDIS_URL=redis://localhost:6379
