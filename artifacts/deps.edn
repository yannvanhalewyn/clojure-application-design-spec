{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.4"}

  ;; System and configuration
  aero/aero                       {:mvn/version "1.1.6"}
  integrant/integrant             {:mvn/version "1.0.1"}
  io.github.cdimascio/dotenv-java {:mvn/version "3.2.0"}

  ;; Web
  hiccup/hiccup           {:mvn/version "2.0.0"}
  metosin/jsonista        {:mvn/version "1.0.0"}
  metosin/malli           {:mvn/version "0.20.1"}
  metosin/reitit          {:mvn/version "0.9.1"}
  ring/ring-core          {:mvn/version "1.12.2"}
  ring/ring-jetty-adapter {:mvn/version "1.12.2"}

  ;; General purpose
  babashka/fs            {:mvn/version "0.5.32"}
  dev.weavejester/medley {:mvn/version "1.10.0"}

  ;; Logging
  ch.qos.logback/logback-classic {:mvn/version "1.5.32"}
  org.clojure/tools.logging      {:mvn/version "1.3.1"}
  org.slf4j/slf4j-api            {:mvn/version "2.0.17"}}

 :aliases
 {;; REPL / development. Include every :service/* alias so (go) can start all.
  :dev
  {:extra-paths ["dev" "test" "build"]
   :extra-deps {djblue/portal                 {:mvn/version "0.63.1"}
                integrant/repl                {:mvn/version "0.5.1"}
                io.github.clojure/tools.build {:mvn/version "0.10.13"}
                org.clojure/tools.namespace   {:mvn/version "1.5.0"}}
   :jvm-opts ["-Djava.awt.headless=true"]}

  :nrepl
  {:extra-deps {nrepl/nrepl       {:mvn/version "1.6.0"}
                cider/cider-nrepl {:mvn/version "0.56.0"}}
   :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}

  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}

  :build
  {:paths ["build"]
   :deps {io.github.clojure/tools.build {:mvn/version "0.10.13"}}
   :ns-default build}

  ;; Only when a service ships ClojureScript islands or an SPA
  :cljs
  {:extra-deps {thheller/shadow-cljs       {:mvn/version "3.2.1"}
                applied-science/js-interop {:mvn/version "0.4.2"}}}

  ;; Heavy libraries needed by a single service. build.clj adds the alias when
  ;; building that service's uberjar.
  ;; :service/worker
  ;; {:extra-deps {org.apache.kafka/kafka-clients {:mvn/version "…"}}}
  }}
